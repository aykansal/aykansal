{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "subtitle": {
        "type": "string",
        "minLength": 1
      },
      "date": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "show": {
        "type": "boolean"
      },
      "featured": {
        "type": "boolean"
      },
      "priority": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "markdownFile": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "slug",
      "title",
      "subtitle",
      "date",
      "tags",
      "show",
      "markdownFile"
    ],
    "additionalProperties": false
  }
}
